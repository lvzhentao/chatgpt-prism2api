# prism-2api compose 环境变量（复制成 .env，chmod 600；rsync 不覆盖它）
# 缺失项由 scripts/deploy.sh 的 bootstrap 现场生成。

# 对外端口（容器内固定 8080）
PRISM_HOST_PORT=8301

# PostgreSQL（仅在 compose 网络内暴露，不映射公网）
PRISM_DB_USER=prism
PRISM_DB_NAME=prism
PRISM_DB_PASSWORD=change-me-openssl-rand-hex-16

# 本站鉴权：调用 /v1/* 需 Authorization: Bearer <这个值>
WEB2API_API_KEY=change-me-openssl-rand-hex-24

# 账号凭据落库加密键；换掉后旧令牌无法解密，需要重新导入
PRISM_ENCRYPT_KEY=change-me-openssl-rand-hex-32

# 上游站点（Prism）。留空会退回脚手架占位符 api.example.com，导致 no such host
VENDOR_API_BASE_URL=https://prism.openai.com

# Anthropic 入口的思考档位上限（low|medium|high|max，默认 low）。
# OpenAI 入口直接吃请求里的 reasoning_effort，不受这个上限约束。
WEB2API_MAX_EFFORT=high

# 没指定模型时的兜底模型（/v1/messages 不带 model、无法识别的模型名都会落到它）。
# 与 internal/adapter/prism/models.go 的 DefaultModel 保持一致。
WEB2API_DEFAULT_MODEL=gpt-5.6-sol

TZ=Asia/Shanghai

# 镜像来源（拉取式部署 scripts/deploy-pull.sh 用；现场构建的 deploy.sh 也会用它给镜像打名）
# 两个镜像共用同一个 Docker Hub 私有仓库，用 tag 区分：
#   PRISM_IMAGE_REPO  = <Docker Hub 用户名>/prism-2api
#   PRISM_APP_TAG     = app-latest    （回滚改成 app-<sha>）
#   PRISM_LOGIN_TAG   = login-latest  （回滚改成 login-<sha>）
# 不设就取默认值（见 docker-compose.yml）。
# PRISM_IMAGE_REPO=your-dockerhub-user/prism-2api
# PRISM_APP_TAG=app-latest
# PRISM_LOGIN_TAG=login-latest
